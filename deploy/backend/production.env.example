# The API's environment on the server (/etc/strategy-trading-lab/api.env). Copy it to production.env next to this
# file (gitignored: never commit the values), fill it in, then run deploy-env.ps1 (VS Code: Terminal → Run Task →
# Deploy backend environment to Oracle). One KEY=value per line, no quotes, no spaces around =.

# The production Neon branch (neon env pull on the production branch writes these to .env.local).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# The dev Neon branch's pooled DATABASE_URL: lets the admin page switch production to dev. Optional.
DATABASE_URL_DEV=

# The owner: the account with this verified email gets the owner role, which alone opens the admin page.
OWNER_EMAIL=
