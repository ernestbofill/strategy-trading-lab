{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "Build backend",
      "program": "${workspaceFolder}/backend/src/StrategyTradingLab.Api/bin/Debug/net10.0/StrategyTradingLab.Api.dll",
      "cwd": "${workspaceFolder}/backend/src/StrategyTradingLab.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5184"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\bNow listening on:\s+(https?://\S+)",
        "uriFormat": "%s/swagger"
      },
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
