<Project>

  <PropertyGroup>
    <!-- Local builds only. deploy/backend/deploy.ps1 publishes with 0.<main's commit count>.0-alpha and tags it as
         backend-v<version>: don't bump this by hand. -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <!-- When the build was made, for GET /version. Release only: a changing value rebuilds the project every time. -->
  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <AssemblyMetadata Include="BuiltAt" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-ddTHH:mm:ssZ'))" />
  </ItemGroup>

</Project>
